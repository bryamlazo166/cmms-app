# URL del webhook Flask del CMMS
#   Desarrollo local:  http://localhost:5009/api/public/whatsapp/webhook
#   Produccion:        https://TU-APP.onrender.com/api/public/whatsapp/webhook
WEBHOOK_URL=http://localhost:5009/api/public/whatsapp/webhook

# Token compartido gateway <-> Flask. Debe coincidir con WHATSAPP_GATEWAY_TOKEN
# en el .env del CMMS. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=

# (Opcional) Numero del dueño SIN + ni espacios (ej: 51987654321).
# Unico autorizado para el comando /grupos (lista JIDs de grupos).
OWNER_NUMBER=

# (Opcional) Cada cuanto se refresca el mapa de identidades @lid, en ms.
# WhatsApp deja ocultar el numero detras de un nombre de usuario; el gateway le
# pregunta a WhatsApp el codigo de identidad de cada numero registrado en el
# CMMS para poder reconocerlos igual. Default: 6 horas.
# LID_SYNC_MS=21600000
